# ----------------------------------------------------------------------
# CoinCompare Environment Variables
# ----------------------------------------------------------------------
# This file contains all the necessary environment variables to run the application.
# For local development, these default values should be sufficient to get started.
# For a production deployment, you should replace these with your own secure values.
# ----------------------------------------------------------------------

# --- PostgreSQL Database Settings ---
# These variables configure the connection to the PostgreSQL database container.
# The default values are used by the 'postgres' service in docker-compose.yml.
POSTGRES_DB=coincompare
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# --- Backend Application Settings ---
# This URL is used by the backend application to connect to the database.
# It should match the PostgreSQL settings above.
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@postgres:5432/coincompare

# This URL is used by the backend to connect to the Redis cache container.
REDIS_URL=redis://redis:6379/0

# IMPORTANT: These are security-sensitive keys.
# For production, you MUST generate your own random, secure keys.
# You can generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY=this-is-a-super-secret-key-for-jwt
ENCRYPTION_KEY=12345678901234567890123456789012

# Application environment and logging level.
ENVIRONMENT=development
LOG_LEVEL=INFO


# --- InfluxDB Time Series Database Settings ---
# These variables are used to initialize the InfluxDB container on its first run.
# The backend service will use these same credentials to connect to it.
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=admin123
DOCKER_INFLUXDB_INIT_ORG=coincompare
DOCKER_INFLUXDB_INIT_BUCKET=trading_data
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=coincompare-local-dev-token-!@#$

# These variables are used by the backend application to connect to InfluxDB.
# They should match the InfluxDB initial setup variables above.
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=coincompare-local-dev-token-!@#$
INFLUXDB_ORG=coincompare
INFLUXDB_BUCKET=trading_data


# --- Grafana Monitoring Dashboard Settings ---
# These are the admin credentials you will use to log in to the Grafana dashboard.
# The Grafana dashboard is accessible at http://localhost:3001
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin123
