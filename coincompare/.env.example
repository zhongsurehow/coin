# This is an example environment file.
# For local development, you can copy this file to .env and use it directly.
# For production, be sure to change the default passwords and secret keys.

# PostgreSQL Credentials
POSTGRES_DB=coincompare
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# InfluxDB Credentials
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=admin123
DOCKER_INFLUXDB_INIT_ORG=coincompare
DOCKER_INFLUXDB_INIT_BUCKET=trading_data
INFLUXDB_TOKEN=coincompare-token-123

# Backend API & Celery Credentials
# IMPORTANT: Change these default values for production for security reasons.
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
ENCRYPTION_KEY=your-32-byte-encryption-key-change-this

# Grafana Credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin123
