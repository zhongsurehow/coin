# This file contains environment variables for the CoinCompare application.
# For local development, you can copy this file to .env and fill in the values.
# The docker-compose.yml file is configured to load variables from .env automatically.

# PostgreSQL Database Settings
POSTGRES_DB=coincompare
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# Backend Application Settings
# IMPORTANT: Change these secrets in a production environment!
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
ENCRYPTION_KEY=your-32-byte-encryption-key-change-this-!
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@postgres:5432/coincompare
REDIS_URL=redis://redis:6379/0
ENVIRONMENT=development
LOG_LEVEL=INFO

# InfluxDB Settings
# This token is used by the backend to communicate with InfluxDB.
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=coincompare-token-123
INFLUXDB_ORG=coincompare
INFLUXDB_BUCKET=trading_data

# InfluxDB Initial Setup (credentials for the InfluxDB container itself)
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=admin123
DOCKER_INFLUXDB_INIT_ORG=coincompare
DOCKER_INFLUXDB_INIT_BUCKET=trading_data
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=coincompare-token-123

# Grafana Admin Credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin123

# Frontend Environment Variables (these are built into the image, not sourced from .env)
# REACT_APP_API_URL=/api/v1
# REACT_APP_WS_URL=/ws
# REACT_APP_ENVIRONMENT=development
